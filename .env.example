APP_NAME="Project Expedition"
# local | testing | production. The seed endpoint is disabled (404) in production.
APP_ENV=local
APP_URL=http://localhost:3000
# Reverse proxies in front of the app that append to X-Forwarded-For (0 = do not trust it).
TRUSTED_PROXY_HOPS=1

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Default: the MySQL 8 service from docker-compose.yml (`docker compose up -d`).
# docker compose reads this file too, so the credentials below are the single
# source of truth for both the container and the application.
#
# Zero-dependency alternative (no Docker): set DB_CONNECTION=sqlite; the file
# database/database.sqlite is created on the first migration.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pe_destinations
DB_USERNAME=laravel
DB_PASSWORD=password
DB_ROOT_PASSWORD=password

# API tokens. The prefix lets secret scanners recognise leaked tokens; the
# expiration is an upper bound (minutes) for every token issued by `npm run api:token`.
TOKEN_PREFIX=pe_
TOKEN_EXPIRATION_MINUTES=129600
